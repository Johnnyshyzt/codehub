# CodeHub environment variables (BYOK)
# Copy to .env and fill in at least one key.

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Qwen / DashScope — https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# QWEN_API_KEY=

# GLM / Zhipu — https://open.bigmodel.cn/
ZHIPU_API_KEY=
# GLM_API_KEY=

# Kimi / Moonshot — https://platform.moonshot.cn/
MOONSHOT_API_KEY=
# KIMI_API_KEY=

# Optional
# CODEHUB_MAX_STEPS=12
# CODEHUB_USAGE_PATH=~/.codehub/usage.json
